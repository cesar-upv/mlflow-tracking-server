# ==========================================
# Project
# ==========================================

COMPOSE_PROJECT_NAME=mlops-local

# ==========================================
# Postgres / MLflow backend store
# ==========================================

POSTGRES_USER=mlflow
POSTGRES_PASSWORD=CHANGE_ME_GENERATED
POSTGRES_DB=mlflow

# ==========================================
# MinIO / S3 artifact store
# ==========================================

AWS_ACCESS_KEY_ID=CHANGE_ME_GENERATED
AWS_SECRET_ACCESS_KEY=CHANGE_ME_GENERATED

S3_BUCKET=mlflow-artifacts
MLFLOW_S3_ENDPOINT_URL=http://storage:9000

# ==========================================
# MLflow
# ==========================================

MLFLOW_VERSION=v3.13.0-full
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000

# ==========================================
# Nginx basic auth
# ==========================================

NGINX_BASIC_AUTH_USER=admin
NGINX_BASIC_AUTH_PASSWORD=CHANGE_ME_GENERATED
